@prefix : <http://w3id.org/rml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://w3id.org/rml/> .

# Written from use-cases/rml/rml-fnml/spec/docs/index.html section 5 (FNML)
# and section 6.3 (Conditions), for comparison against rml-fnml.owl. Differs
# from rml-fnml.owl in three places:
#   1. :functionMap's domain is :FunctionExecution here, not :Input --
#      matches spec section 5.9 ("Links a Function Execution with
#      Function. Domain: rml:FunctionExecution"); rml-fnml.owl has :Input.
#   2. :inputValue is owl:DatatypeProperty with range xsd:string here, not
#      owl:ObjectProperty -- every example uses it as a plain string
#      literal (rml:inputValue " ", rml:inputValue "-"), and an
#      ObjectProperty cannot legally take a literal value at all.
#   3. :condition is defined here (section 6.3); rml-fnml.owl doesn't
#      declare it at all.

#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/rml/functionExecution
:functionExecution rdf:type owl:ObjectProperty ;
           rdfs:domain :ExpressionMap ;
           rdfs:range :FunctionExecution ;
           rdfs:comment "Denotes the execution of a function with its required input parameters and values."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
           rdfs:label "function execution" .


###  http://w3id.org/rml/function
:function rdf:type owl:ObjectProperty ;
          rdfs:domain :FunctionExecution ;
          rdfs:range rdfs:Resource ;
          rdfs:comment "Constant expression shortcut of rml:functionMap: specifies a data transformation function directly."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
          rdfs:label "function" .


###  http://w3id.org/rml/functionMap
:functionMap rdf:type owl:ObjectProperty ;
             rdfs:domain :FunctionExecution ;
             rdfs:range :FunctionMap ;
             rdfs:comment "A Function Map element to generate the data transformation function."@en ;
             rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
             rdfs:label "function map" .


###  http://w3id.org/rml/input
:input rdf:type owl:ObjectProperty ;
       rdfs:domain :FunctionExecution ;
       rdfs:range :Input ;
       rdfs:comment "Links a Function Execution with its Inputs."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
       rdfs:label "input" .


###  http://w3id.org/rml/parameter
:parameter rdf:type owl:ObjectProperty ;
           rdfs:domain :Input ;
           rdfs:range rdfs:Resource ;
           rdfs:comment "Constant expression shortcut of rml:parameterMap: specifies the parameter of a function directly."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
           rdfs:label "parameter" .


###  http://w3id.org/rml/parameterMap
:parameterMap rdf:type owl:ObjectProperty ;
              rdfs:domain :Input ;
              rdfs:range :ParameterMap ;
              rdfs:comment "A Parameter Map element to generate the parameter of a function."@en ;
              rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
              rdfs:label "parameter map" .


###  http://w3id.org/rml/return
:return rdf:type owl:ObjectProperty ;
        rdfs:domain :ExpressionMap ;
        rdfs:range rdfs:Resource ;
        rdfs:comment "Constant expression shortcut of rml:returnMap: specifies which Return of the function to use directly."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
        rdfs:label "return" .


###  http://w3id.org/rml/returnMap
:returnMap rdf:type owl:ObjectProperty ;
           rdfs:domain :ExpressionMap ;
           rdfs:range :ReturnMap ;
           rdfs:comment "A Return Map element selecting which Return of the function's execution to use. Defaults to the function's first declared Return if omitted."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
           rdfs:label "return map" .


###  http://w3id.org/rml/inputValueMap
:inputValueMap rdf:type owl:ObjectProperty ;
          rdfs:domain :Input ;
          rdfs:range :TermMap ;
          rdfs:comment "A term map generating the value supplied for the Input's parameter."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
          rdfs:label "input value map" .


###  http://w3id.org/rml/inputValue
:inputValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :Input ;
          rdfs:range xsd:string ;
          rdfs:comment "Constant expression shortcut of rml:inputValueMap: specifies the value supplied for the Input's parameter directly, as a string Literal."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
          rdfs:label "input value" .


###  http://w3id.org/rml/condition
:condition rdf:type owl:ObjectProperty ;
          rdfs:domain :ExpressionMap ;
          rdfs:range :ExpressionMap ;
          rdfs:comment "Shortcut on an Expression Map: its value must be a boolean-returning Function-valued Expression Map. If the condition evaluates to true, the enclosing Expression Map's own value is used; see section 6.3 (Conditions)."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
          rdfs:label "condition" .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/rml/FunctionExecution
:FunctionExecution rdf:type owl:Class ;
           rdfs:comment "Represents a function execution: a function plus its required input parameters and values."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
           rdfs:label "Function Execution" .


###  http://w3id.org/rml/FunctionMap
:FunctionMap rdf:type owl:Class ;
             rdfs:subClassOf :TermMap ;
             rdfs:comment "Represents a function map: a term map generating the FnO function to execute."@en ;
             rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
             rdfs:label "Function Map" .


###  http://w3id.org/rml/Input
:Input rdf:type owl:Class ;
       rdfs:comment "Represents an input parameter/value pair for a function execution."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
       rdfs:label "Input" .


###  http://w3id.org/rml/ParameterMap
:ParameterMap rdf:type owl:Class ;
              rdfs:subClassOf :TermMap ;
              rdfs:comment "Represents a parameter map: a term map generating the parameter of a function."@en ;
              rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
              rdfs:label "Parameter Map" .


###  http://w3id.org/rml/ReturnMap
:ReturnMap rdf:type owl:Class ;
           rdfs:subClassOf :TermMap ;
           rdfs:comment "Represents a return map: a term map generating which Return of a function's execution to use."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/fnml/> ;
           rdfs:label "Return Map" .