@prefix : <http://w3id.org/rml/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix enc: <http://w3id.org/rml/enc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix comp: <http://w3id.org/rml/comp#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix formats: <http://www.w3.org/ns/formats/> .
@base <http://w3id.org/rml/> .

# REVIEW COPY -- not wired into the build. Written by re-deriving the
# vocabulary directly from use-cases/rml/rml-io/spec/docs/index.html
# (sections 3-8) to compare against the existing rml-io.owl. Differences
# from the existing file, all confirmed against spec text:
#
#   1. :path's domain was :LogicalSource; every example in the spec puts
#      rml:path on the nested source/target access description, never on
#      LogicalSource itself. Domain fixed to :FilePath.
#   2. The existing ontology names this access-description class
#      :RelativePath; the spec text and every example consistently call it
#      rml:FilePath ("subclasses rml:Source as rml:FilePath", "a rml:Source,
#      rml:FilePath" in every example). Renamed to :FilePath.
#   3. :CurrentWorkingDirectory and :MappingDirectory were declared as
#      owl:Class, but are used as enumerated *values* of rml:root
#      (rml:root rml:CurrentWorkingDirectory), the same pattern as the
#      Compression/Encoding individuals. Changed to owl:NamedIndividual.
#   4. :targzip should be :targz -- the spec text names it
#      "rml:targz: Tar archive with GZip compression" (section 3.2.2 /
#      4.2.3); "targzip" does not appear anywhere in the spec.
#   5. rml:Mode (section 4.2.2) was entirely missing: no :Mode class, no
#      :mode property, none of the six individuals (Read, ReadWrite, Write,
#      WriteRead, Append, AppendRead). Added below.
#   6. :logicalTarget's domain is a union of :TermMap and :LanguageMap in
#      the existing file; the spec's own property table states domain =
#      rml:TermMap only (section 6). Kept as rml:TermMap here since that's
#      what the spec states; flagging the discrepancy rather than silently
#      dropping the union, in case :LanguageMap was an intentional widening
#      the spec text doesn't document.
#
# rml:referenceFormulation and rml:iterator are not redeclared here -- they
# already exist in rml-core.owl (Iterable), which this ontology imports.

<http://w3id.org/rml/io/> rdf:type owl:Ontology ;
                           owl:versionIRI :io ;
                           owl:imports <http://w3id.org/rml/core/> ;
                           dc:contributor "Ana Iglesias Molina" ,
                                          "Anastasia Dimou" ,
                                          "Dylan Van Assche" ,
                                          "Pano Maria" ;
                           dc:created "2023-03-14" ;
                           dc:description "RML-IO enables the description of input data sources and target output data serialization "@en ;
                           dc:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
                           dc:modified "2025-01-18" ;
                           dc:publisher <https://www.w3.org/community/kg-construct/> ;
                           dc:title "RML-IO: Source and Target"@en ;
                           bibo:status "draft" ;
                           vann:preferredNamespacePrefix "rml" ;
                           vann:preferredNamespaceUri "http://w3id.org/rml/" ;
                           owl:versionInfo "0.1.0" .

#################################################################
#    Annotation properties
#################################################################

cc:license rdf:type owl:AnnotationProperty .
dc:contributor rdf:type owl:AnnotationProperty .
dc:creator rdf:type owl:AnnotationProperty .
dc:description rdf:type owl:AnnotationProperty .
dc:issued rdf:type owl:AnnotationProperty .
dc:modified rdf:type owl:AnnotationProperty .
dc:publisher rdf:type owl:AnnotationProperty .
dc:title rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .
vaem:acronym rdf:type owl:AnnotationProperty .
foaf:name rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/rml/compression
:compression rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Source
                                         :Target
                                       )
                         ] ;
             rdfs:range :Compression ;
             rdfs:comment "Defines the compression format of a Source or Target."@en ;
             rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
             rdfs:label "compression" .


###  http://w3id.org/rml/encoding
:encoding rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Source
                                      :Target
                                    )
                      ] ;
          rdfs:range :Encoding ;
          rdfs:comment "Defines the encoding format of a Source or Target."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
          rdfs:label "encoding" .


###  http://w3id.org/rml/logicalTarget
:logicalTarget rdf:type owl:ObjectProperty ;
               rdfs:domain :TermMap ;
               rdfs:range :LogicalTarget ;
               rdfs:comment "Represents the logical target to where triples are exported to. A Term Map MAY contain one or more rml:logicalTarget properties."@en ;
               rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
               rdfs:label "logical target" .


###  http://w3id.org/rml/mode
:mode rdf:type owl:ObjectProperty ;
      rdfs:domain :Target ;
      rdfs:range :Mode ;
      rdfs:comment "Describes the operation mode when accessing a Target (read, write, append, etc.). Defaults to rml:Write if not specified."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "mode" .


###  http://w3id.org/rml/namespace
:namespace rdf:type owl:ObjectProperty ;
           rdfs:domain :XPathReferenceFormulation ;
           rdfs:range :Namespace ;
           rdfs:comment "A namespace for describing a XPath reference formulation."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
           rdfs:label "namespace" .


###  http://w3id.org/rml/root
:root rdf:type owl:ObjectProperty ;
      rdfs:domain :FilePath ;
      rdfs:range [ rdf:type owl:Class ;
                   owl:unionOf ( :CurrentWorkingDirectory
                                 :MappingDirectory
                                 rdf:Literal
                               )
                 ] ;
      rdfs:comment "Defines the root of the relative path. Defaults to rml:CurrentWorkingDirectory if not specified."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "root" .


###  http://w3id.org/rml/serialization
:serialization rdf:type owl:ObjectProperty ;
               rdfs:domain :LogicalTarget ;
               rdfs:range formats:Format ;
               rdfs:comment "Defines the serialization to generate the target output. Defaults to N-Quads if not specified."@en ;
               rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
               rdfs:label "serialization" .


###  http://w3id.org/rml/source
:source rdf:type owl:ObjectProperty ;
        rdfs:domain :LogicalSource ;
        rdfs:range :Source ;
        rdfs:comment "Defines the source that describes the input data. Exactly one is required on a LogicalSource."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "source" .


###  http://w3id.org/rml/target
:target rdf:type owl:ObjectProperty ;
        rdfs:domain :LogicalTarget ;
        rdfs:range :Target ;
        rdfs:comment "Defines the target that describes the output data. Exactly one is required on a LogicalTarget."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "target" .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/rml/namespacePrefix
:namespacePrefix rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Namespace ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Describes the prefix of a namespace."@en ;
                 rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
                 rdfs:label "namespace prefix" .


###  http://w3id.org/rml/namespaceURL
:namespaceURL rdf:type owl:DatatypeProperty ;
              rdfs:domain :Namespace ;
              rdfs:range xsd:string ;
              rdfs:comment "Describes the URL of a namespace."@en ;
              rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
              rdfs:label "namespace URL" .


###  http://w3id.org/rml/null
:null rdf:type owl:DatatypeProperty ;
      rdfs:domain :Source ;
      rdfs:range xsd:string ;
      rdfs:comment "Describes which data values inside the source should be considered as NULL. Multiple values allowed."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "null" .


###  http://w3id.org/rml/path
:path rdf:type owl:DatatypeProperty ;
      rdfs:domain :FilePath ;
      rdfs:range xsd:string ;
      rdfs:comment "Denotes the path to a source or target resource. Used on the nested FilePath access description, not directly on LogicalSource/LogicalTarget."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "path" .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/rml/Compression
:Compression rdf:type owl:Class ;
             rdfs:comment "Represents file compression schemes."@en ;
             rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
             rdfs:label "compression class" .


###  http://w3id.org/rml/CurrentWorkingDirectory
###  NOTE: individual, not a class -- see Individuals section below.


###  http://w3id.org/rml/Encoding
:Encoding rdf:type owl:Class ;
          rdfs:comment "Represents encoding formats."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
          rdfs:label "Encoding class" .


###  http://w3id.org/rml/FilePath
:FilePath rdf:type owl:Class ;
          rdfs:comment "A source or target access description for files, relative to the current working directory, the mapping directory, or an absolute root path. Used together with rml:Source (as a value of rml:source) or rml:Target (as a value of rml:target), e.g. 'a rml:Source, rml:FilePath'."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
          rdfs:label "File Path" .


###  http://w3id.org/rml/LogicalSource
:LogicalSource rdf:type owl:Class ;
               rdfs:subClassOf :AbstractLogicalSource ;
               rdfs:comment "Denotes a logical source."@en ;
               rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
               rdfs:label "Logical Source" .


###  http://w3id.org/rml/LogicalTarget
:LogicalTarget rdf:type owl:Class ;
               rdfs:comment "Denotes a logical target: any target to where RDF triples are exported to."@en ;
               rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
               rdfs:label "LogicalTarget" .


###  http://w3id.org/rml/MappingDirectory
###  NOTE: individual, not a class -- see Individuals section below.


###  http://w3id.org/rml/Mode
:Mode rdf:type owl:Class ;
      rdfs:comment "Represents the operation mode when accessing a Target."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "Mode class" .


###  http://w3id.org/rml/Namespace
:Namespace rdf:type owl:Class ;
           rdfs:comment "Denotes a namespace, used by an XPath reference formulation."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
           rdfs:label "Namespace" .


###  http://w3id.org/rml/ReferenceFormulation
:ReferenceFormulation rdf:type owl:Class ;
                      rdfs:comment "Denotes a Reference Formulation, defining how to express a reference to elements of the data of an input data source."@en ;
                      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
                      rdfs:label "Reference Formulation" .


###  http://w3id.org/rml/Source
:Source rdf:type owl:Class ;
        rdfs:comment "Denotes a source, defining how a data source should be accessed. Complements other source descriptions such as SD Service, CSVW Table, DCAT Distribution, etc."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "Source" .


###  http://w3id.org/rml/Target
:Target rdf:type owl:Class ;
        rdfs:comment "Denotes a target, defining how a target must be accessed when exporting RDF triples."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "Target" .


###  http://w3id.org/rml/XPathReferenceFormulation
:XPathReferenceFormulation rdf:type owl:Class ;
                           rdfs:subClassOf :ReferenceFormulation ;
                           rdfs:comment "Denotes a XPath Reference Formulation, optionally with the definition of XML namespaces used in references."@en ;
                           rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
                           rdfs:label "XPath Reference Formulation" .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#Literal
rdf:Literal rdf:type owl:Class .


###  http://www.w3.org/ns/formats/Format
formats:Format rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://w3id.org/rml/CSV
:CSV rdf:type owl:NamedIndividual ,
              :ReferenceFormulation ;
     rdfs:comment "Denotes that the CSV file's column names are used for referring to extracts of CSV resources."@en ;
     rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
     rdfs:label "CSV" ;
     rdfs:seeAlso <http://tools.ietf.org/html/rfc4180> .


###  http://w3id.org/rml/JSONPath
:JSONPath rdf:type owl:NamedIndividual ,
                   :ReferenceFormulation ;
          rdfs:comment "Denotes the JSONPath reference formulation, used for referring to extracts of JSON sources."@en ;
          rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
          rdfs:label "JSONPath" .


###  http://w3id.org/rml/SQL2008Query
:SQL2008Query rdf:type owl:NamedIndividual ,
                       :ReferenceFormulation ;
              rdfs:comment "Denotes a query in SQL 2008."@en ;
              rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
              rdfs:label "SQL 2008 Query" .


###  http://w3id.org/rml/SQL2008Table
:SQL2008Table rdf:type owl:NamedIndividual ,
                       :ReferenceFormulation ;
              rdfs:comment "Denotes a table in SQL 2008. Shortcut to select all columns from the table."@en ;
              rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
              rdfs:label "SQL 2008 Table" .


###  http://w3id.org/rml/UTF-16
:UTF-16 rdf:type owl:NamedIndividual ,
                 :Encoding ;
        rdfs:comment "Represents the UTF-16 encoding."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "UTF-16" .


###  http://w3id.org/rml/UTF-8
:UTF-8 rdf:type owl:NamedIndividual ,
                :Encoding ;
       rdfs:comment "Represents the UTF-8 encoding."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
       rdfs:label "UTF-8" .


###  http://w3id.org/rml/XPath
:XPath rdf:type owl:NamedIndividual ,
                :ReferenceFormulation ;
       rdfs:comment "Denotes the XPath reference formulation, used for referring to extracts of XML sources. Use rml:XPathReferenceFormulation instead when namespaces need to be declared."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
       rdfs:label "XPath" ;
       rdfs:seeAlso <http://www.w3.org/TR/xpath20/> .


###  http://w3id.org/rml/gzip
:gzip rdf:type owl:NamedIndividual ,
               :Compression ;
      rdfs:comment "Represents GZip file compression."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "GZip" .


###  http://w3id.org/rml/none
:none rdf:type owl:NamedIndividual ,
               :Compression ;
      rdfs:comment "Represents no compression."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "None" .


###  http://w3id.org/rml/targz
:targz rdf:type owl:NamedIndividual ,
               :Compression ;
       rdfs:comment "Represents Tar archive with GZip compression."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
       rdfs:label "TarGZip" .


###  http://w3id.org/rml/tarxz
:tarxz rdf:type owl:NamedIndividual ,
                :Compression ;
       rdfs:comment "Represents Tar archive with Xz compression."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
       rdfs:label "TarXz" .


###  http://w3id.org/rml/zip
:zip rdf:type owl:NamedIndividual ,
              :Compression ;
     rdfs:comment "Represents Zip archive with Zip compression."@en ;
     rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
     rdfs:label "Zip" .


###  http://w3id.org/rml/CurrentWorkingDirectory
:CurrentWorkingDirectory rdf:type owl:NamedIndividual ;
                         rdfs:comment "Denotes the path relative to the current working directory of the RML processor. Default value of rml:root."@en ;
                         rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
                         rdfs:label "Current Working Directory" .


###  http://w3id.org/rml/MappingDirectory
:MappingDirectory rdf:type owl:NamedIndividual ;
                  rdfs:comment "Denotes the path relative to the location of the RML mapping."@en ;
                  rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
                  rdfs:label "Mapping Directory" .


###  http://w3id.org/rml/Read
:Read rdf:type owl:NamedIndividual ,
               :Mode ;
      rdfs:comment "Read-only mode (r). Start at the beginning of the file. File must exist. Not useful for targets."@en ;
      rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
      rdfs:label "Read" .


###  http://w3id.org/rml/ReadWrite
:ReadWrite rdf:type owl:NamedIndividual ,
                    :Mode ;
           rdfs:comment "Read-write mode (r+). Start at the beginning of the file, no truncation. File must exist. Only the write part is useful for targets."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
           rdfs:label "Read Write" .


###  http://w3id.org/rml/Write
:Write rdf:type owl:NamedIndividual ,
                :Mode ;
       rdfs:comment "Write mode (w). Truncate/create the file and start at the beginning to add new data. Default mode."@en ;
       rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
       rdfs:label "Write" .


###  http://w3id.org/rml/WriteRead
:WriteRead rdf:type owl:NamedIndividual ,
                    :Mode ;
           rdfs:comment "Write-read mode (w). Truncate/create the file and start at the beginning to add new data. Only the write part is useful for targets."@en ;
           rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
           rdfs:label "Write Read" .


###  http://w3id.org/rml/Append
:Append rdf:type owl:NamedIndividual ,
                 :Mode ;
        rdfs:comment "Append-only mode. Existing file is kept and new data is appended at the end. File is created if it does not exist."@en ;
        rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
        rdfs:label "Append" .


###  http://w3id.org/rml/AppendRead
:AppendRead rdf:type owl:NamedIndividual ,
                     :Mode ;
            rdfs:comment "Append-read mode. Existing file is kept and new data is appended at the end. File is created if it does not exist."@en ;
            rdfs:isDefinedBy <http://w3id.org/rml/io/> ;
            rdfs:label "Append Read" .