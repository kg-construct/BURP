@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix ex: <http://example.com/base/> .

ex:StudentMap a rml:TriplesMap ;
    rml:logicalSource [ a rml:LogicalSource ;
        rml:iterator "$.students[*]" ;
        rml:referenceFormulation rml:JSONPath ;
        rml:source [ a rml:RelativePathSource ;
            rml:root rml:MappingDirectory ;
            rml:path "student.json"
        ]
    ] ;
    rml:subjectMap [
        rml:template "http://example.com/student/{$.ID}"
    ] ;
    rml:predicateObjectMap [
        rml:predicate foaf:name ;
        rml:objectMap [
            rml:reference "$.Name"
        ]
    ], [
        rml:predicate ex:enrolledIn ;
        rml:objectMap [ a rml:RefObjectMap ;
            rml:parentTriplesMap ex:EnrollmentMap ;
            rml:joinCondition [
                rml:child "$.ID" ;
                rml:parent "$.StudentID"
            ]
        ]
    ] .

ex:EnrollmentMap a rml:TriplesMap ;
    rml:logicalSource [ a rml:LogicalSource ;
        rml:iterator "$.enrollments[*]" ;
        rml:referenceFormulation rml:JSONPath ;
        rml:source [ a rml:RelativePathSource ;
            rml:root rml:MappingDirectory ;
            rml:path "enrollment.json"
        ]
    ] ;
    rml:subjectMap [
        rml:template "http://example.com/enrollment/{$.StudentID}_{$.CourseID}"
    ] ;
    rml:predicateObjectMap [
        rml:predicate ex:course ;
        rml:objectMap [ a rml:RefObjectMap ;
            rml:parentTriplesMap ex:CourseMap ;
            rml:joinCondition [
                rml:child "$.CourseID" ;
                rml:parent "$.ID"
            ]
        ]
    ] .

ex:CourseMap a rml:TriplesMap ;
    rml:logicalSource [ a rml:LogicalSource ;
        rml:iterator "$.courses[*]" ;
        rml:referenceFormulation rml:JSONPath ;
        rml:source [ a rml:RelativePathSource ;
            rml:root rml:MappingDirectory ;
            rml:path "course.json"
        ]
    ] ;
    rml:subjectMap [
        rml:template "http://example.com/course/{$.ID}"
    ] ;
    rml:predicateObjectMap [
        rml:predicate rdfs:label ;
        rml:objectMap [
            rml:reference "$.Title"
        ]
    ] .
