@prefix ex: <http://example.org/>.
@prefix rml: <http://w3id.org/rml/>.
@prefix idlab-fn: <https://w3id.org/imec/idlab/function#> .

ex:PersonMapping a rml:TriplesMap;
  rml:logicalSource [
    a rml:LogicalSource;
    rml:referenceFormulation rml:JSONPath;
    rml:iterator "$[*]";
    rml:source [
      a rml:RelativePathSource;
      rml:root rml:MappingDirectory;
      rml:path "../complete_reference_schema/data.json";
    ];
  ];
  rml:subjectMap [ rml:template "http://example.org/person/{$.firstName}" ];
  rml:predicateObjectMap [
    rml:predicate ex:name;
    rml:objectMap [ rml:functionExecution [
      rml:function idlab-fn:concat;
      rml:input [
        rml:parameter idlab-fn:a;
        rml:inputValueMap [ rml:reference "$.firstName" ];
      ];
      rml:input [
        rml:parameter idlab-fn:otherStr;
        rml:inputValueMap [ rml:reference "$.lastname" ];
      ];
      rml:input [
        rml:parameter idlab-fn:delimiter;
        rml:inputValueMap [ rml:constant " " ];
      ];
    ] ];
  ].

